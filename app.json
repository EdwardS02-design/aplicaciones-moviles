{
  "expo": {
    "name": "Petcare",
    "slug": "Petcare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Para fotografiar a tu mascota.",
        "NSPhotoLibraryUsageDescription": "Para elegir una foto de la galería.",
        "NSLocationWhenInUseUsageDescription": "Para mostrarte parques y veterinarias cerca."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Petcare usa tus fotos para el perfil de cada mascota.",
          "cameraPermission": "Petcare usa la cámara para fotografiar a tu mascota."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Así encontramos parques y veterinarias cerca de ti."
        }
      ],
      "expo-font"
    ]
  }
}
